{
  "name": "PerformanceReport",
  "type": "object",
  "properties": {
    "trainee_id": {
      "type": "string",
      "description": "Auth user ID"
    },
    "trainee_name": {
      "type": "string"
    },
    "report_month": {
      "type": "string",
      "description": "YYYY-MM format"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "attendance_pct": {
      "type": "number"
    },
    "workouts_completed": {
      "type": "number"
    },
    "baseline_improvements": {
      "type": "string"
    },
    "conditioning_score": {
      "type": "number"
    },
    "strength_score": {
      "type": "number"
    },
    "mobility_score": {
      "type": "number"
    },
    "recovery_consistency": {
      "type": "number"
    },
    "readiness_score": {
      "type": "number",
      "description": "Promotion readiness 0-100"
    },
    "coach_comments": {
      "type": "string"
    },
    "skill_progression": {
      "type": "string"
    },
    "goals_next_month": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "trainee_id",
    "report_month"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}