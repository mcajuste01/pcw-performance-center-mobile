{
  "name": "BodyStat",
  "type": "object",
  "properties": {
    "trainee_id": {
      "type": "string",
      "description": "Auth user ID of the trainee"
    },
    "trainee_name": {
      "type": "string",
      "description": "Trainee display name at time of logging"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of measurement"
    },
    "weight": {
      "type": "number",
      "description": "Body weight in lbs"
    },
    "body_fat_percent": {
      "type": "number",
      "description": "Body fat percentage"
    },
    "chest": {
      "type": "number",
      "description": "Chest measurement in inches"
    },
    "waist": {
      "type": "number",
      "description": "Waist measurement in inches"
    },
    "hips": {
      "type": "number",
      "description": "Hips measurement in inches"
    },
    "arm": {
      "type": "number",
      "description": "Arm measurement in inches"
    },
    "thigh": {
      "type": "number",
      "description": "Thigh measurement in inches"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    }
  },
  "required": [
    "trainee_id",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}