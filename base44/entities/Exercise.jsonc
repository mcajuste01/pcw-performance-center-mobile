{
  "name": "Exercise",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Exercise name"
    },
    "description": {
      "type": "string",
      "description": "Brief description"
    },
    "muscle_groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "default": "intermediate"
    },
    "instructions": {
      "type": "string"
    },
    "tips": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "sets": {
      "type": "string"
    },
    "reps": {
      "type": "string"
    },
    "rest_seconds": {
      "type": "number"
    },
    "created_by": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "strength",
        "conditioning",
        "mobility",
        "technique",
        "ring_movement",
        "power",
        "plyometrics",
        "core",
        "recovery",
        "warmup"
      ],
      "default": "strength"
    }
  },
  "required": [
    "name",
    "muscle_groups",
    "difficulty",
    "instructions"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "trainee"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.created_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.created_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}