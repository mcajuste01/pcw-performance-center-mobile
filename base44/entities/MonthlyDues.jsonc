{
  "name": "MonthlyDues",
  "type": "object",
  "properties": {
    "trainee_id": {
      "type": "string",
      "description": "Auth user ID of the trainee"
    },
    "trainee_name": {
      "type": "string",
      "description": "Trainee display name"
    },
    "month": {
      "type": "string",
      "description": "YYYY-MM format (e.g. 2026-07)"
    },
    "paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether dues are paid/verified for this month"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "confirmed_by": {
      "type": "string",
      "description": "Who confirmed payment (trainee self-confirm or admin user ID)"
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "description": "Admin-set block \u2014 trainee sees payment reminder instead of app"
    },
    "blocked_date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number",
      "description": "Dues amount"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "trainee_id",
    "month"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}