{
  "name": "Payment",
  "type": "object",
  "properties": {
    "trainee_id": {
      "type": "string",
      "description": "Trainee user ID"
    },
    "amount": {
      "type": "number",
      "description": "Payment amount"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Date of payment"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "square",
        "paypal",
        "cash",
        "other"
      ],
      "description": "Payment method used"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Billing period start"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "Billing period end"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "overdue"
      ],
      "default": "pending",
      "description": "Payment status"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "recorded_by": {
      "type": "string",
      "description": "Coach who recorded the payment"
    }
  },
  "required": [
    "trainee_id",
    "amount",
    "payment_date"
  ],
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "coach" } },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recorded_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}