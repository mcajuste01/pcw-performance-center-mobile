{
  "name": "NotebookEntry",
  "type": "object",
  "properties": {
    "trainee_id": {
      "type": "string",
      "description": "User ID of trainee"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "drill",
        "promo",
        "injury",
        "match_reflection",
        "general"
      ],
      "description": "Type of notebook entry"
    },
    "title": {
      "type": "string",
      "description": "Entry title"
    },
    "content": {
      "type": "string",
      "description": "Entry content"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Entry date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for organization"
    }
  },
  "required": [
    "trainee_id",
    "entry_type",
    "title",
    "content"
  ],
  "rls": {
    "create": {
      "data.trainee_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}