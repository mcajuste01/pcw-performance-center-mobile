{
  "name": "AccountabilityGroup",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "pair",
        "pod"
      ],
      "description": "pair = 2 athletes, pod = small group"
    },
    "name": {
      "type": "string",
      "description": "Group display name"
    },
    "created_by": {
      "type": "string",
      "description": "Auth user ID of the creator"
    },
    "created_by_name": {
      "type": "string",
      "description": "Display name of the creator"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "type",
    "name",
    "created_by"
  ],
  "rls": {
    "create": {
      "data.created_by": "{{user.id}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.created_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}