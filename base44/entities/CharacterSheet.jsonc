{
  "name": "CharacterSheet",
  "type": "object",
  "properties": {
    "trainee_id": {
      "type": "string",
      "description": "Auth user ID of the trainee"
    },
    "trainee_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "reviewed"
      ],
      "default": "draft"
    },
    "form_data": {
      "type": "object",
      "description": "Full character builder form data"
    },
    "coach_critique": {
      "type": "string",
      "description": "Coach written critique"
    },
    "coach_id": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "trainee_id"
  ],
  "rls": {
    "create": {
      "data.trainee_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "$or": [
              {
                "role": "coach"
              },
              {
                "role": "admin"
              }
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "$or": [
              {
                "role": "coach"
              },
              {
                "role": "admin"
              }
            ]
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}