{
  "name": "ReadinessCheckIn",
  "type": "object",
  "properties": {
    "trainee_id": {
      "type": "string",
      "description": "Auth user ID"
    },
    "trainee_name": {
      "type": "string"
    },
    "check_in_date": {
      "type": "string",
      "format": "date"
    },
    "sleep": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Sleep quality 1-5"
    },
    "energy": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Energy level 1-5"
    },
    "soreness": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Muscle soreness 1-5 (5=very sore)"
    },
    "stress": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Stress level 1-5"
    },
    "pain": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Pain level 0-10"
    },
    "water_intake": {
      "type": "string",
      "description": "Water intake (glasses or oz)"
    },
    "nutrition": {
      "type": "string",
      "enum": [
        "poor",
        "fair",
        "good",
        "excellent"
      ],
      "description": "Nutrition quality today"
    },
    "readiness_score": {
      "type": "number",
      "description": "Calculated 0-100 readiness score"
    },
    "flagged": {
      "type": "boolean",
      "default": false,
      "description": "Auto-flagged for lighter session"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "trainee_id",
    "check_in_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}