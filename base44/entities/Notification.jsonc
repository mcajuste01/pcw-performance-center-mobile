{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who receives the notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "direct_message",
        "group_message",
        "mention",
        "message_request",
        "announcement",
        "pinned_message",
        "assignment_submitted",
        "video_uploaded",
        "check_in_pending",
        "attendance_verified",
        "coach_request"
      ],
      "description": "Type of notification"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification content"
    },
    "sender_id": {
      "type": "string",
      "description": "User who triggered the notification"
    },
    "channel_id": {
      "type": "string",
      "description": "Related channel ID if applicable"
    },
    "message_id": {
      "type": "string",
      "description": "Related message ID if applicable"
    },
    "thread_id": {
      "type": "string",
      "description": "Related DM thread ID if applicable"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether notification has been read"
    },
    "action_url": {
      "type": "string",
      "description": "URL to navigate to when clicked"
    }
  },
  "required": [
    "user_id",
    "type",
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "$or": [
          {
            "role": "coach"
          },
          {
            "role": "admin"
          }
        ]
      }
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}