{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string",
      "description": "User ID of sender"
    },
    "recipient_id": {
      "type": "string",
      "description": "User ID of recipient"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "message",
        "feedback",
        "task",
        "session_request"
      ],
      "default": "message",
      "description": "Type of message"
    },
    "task_details": {
      "type": "object",
      "description": "Task details if message_type is task",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "due_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "session_details": {
      "type": "object",
      "description": "Session details if message_type is session_request",
      "properties": {
        "proposed_date": {
          "type": "string",
          "format": "date-time"
        },
        "duration_minutes": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether message has been read"
    },
    "accepted": {
      "type": "boolean",
      "default": false,
      "description": "Whether message request has been accepted"
    },
    "thread_id": {
      "type": "string",
      "description": "Groups related messages together"
    },
    "reply_to_id": {
      "type": "string",
      "description": "ID of message being replied to for threading"
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "emoji": {
            "type": "string"
          },
          "user_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Message reactions"
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "description": "Whether message is pinned"
    },
    "pinned_by": {
      "type": "string",
      "description": "User ID who pinned the message"
    },
    "pinned_at": {
      "type": "string",
      "format": "date-time",
      "description": "When message was pinned"
    }
  },
  "required": [
    "sender_id",
    "recipient_id",
    "message"
  ],
  "rls": {
    "create": {
      "data.sender_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}