{
  "name": "WrestlingMetric",
  "type": "object",
  "properties": {
    "trainee_id": {
      "type": "string",
      "description": "Auth user ID"
    },
    "trainee_name": {
      "type": "string"
    },
    "test_date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "enum": [
        "conditioning",
        "strength",
        "agility"
      ],
      "description": "Metric category"
    },
    "metric_name": {
      "type": "string",
      "description": "e.g. Rope runs in 60s, Grip endurance, Lateral movement"
    },
    "value": {
      "type": "number",
      "description": "Recorded value"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measurement (reps, seconds, etc.)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "trainee_id",
    "test_date",
    "category",
    "metric_name",
    "value"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.trainee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}